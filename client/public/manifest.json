{
  "manifest_version": 3,
  "name": "PAIT - Personal AI Assistant",
  "version": "1.0.0",
  "description": "AI Translator & Summarizer Extension",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open PAIT"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}

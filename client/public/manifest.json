{
  "manifest_version": 3,
  "name": "PAIT - Personal AI Assistant",
  "version": "1.0.0",
  "description": "AI Translator & Summarizer Extension",
  "action": {
    "default_title": "Open PAIT"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
